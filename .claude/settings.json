{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(supabase:*)",
      "Bash(npx playwright:*)",
      "Bash(xargs cat *)",
      "Bash(wc -l /c/Projetos/lojaamordapatria/src/pages/*.tsx)",
      "Bash(python -c ' *)",
      "Bash(python -)",
      "Bash(git check-ignore *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && file=$(echo '$CLAUDE_TOOL_INPUT' | grep -oP '\"file_path\":\\s*\"\\K[^\"]+' | head -1) && case \"$file\" in *.ts|*.tsx) pnpm tsc --noEmit 2>&1 | grep -E '^src.*error TS' | head -5 ;; esac"
          }
        ]
      }
    ]
  }
}
